# The CRM is the website's single backend and MySQL source of truth.
# Local development: CRM on port 3000 and Website on port 3002.
CRM_BACKEND_URL=http://127.0.0.1:3000

# Browser-facing URL for the separate Fastonmed administration application.
# Set this to the deployed CRM/admin domain in production.
ADMIN_PANEL_URL=http://localhost:3000
